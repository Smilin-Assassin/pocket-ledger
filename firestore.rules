rules_version = '2';
// Pocket Ledger: everyone has a private space; groups are shared.
//  - Only members can add things to a space; only the person who added something can change or delete it.
//  - "viewers" can look at someone's private space (after that person allowed it) but can't change anything.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function space(hid) { return get(/databases/$(database)/documents/households/$(hid)).data; }
    // invite-only: you're in once the server has written access/{your uid}
    function hasAccess() { return signedIn() && exists(/databases/$(database)/documents/access/$(me())); }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/access/$(me())).data.get('admin', false) == true; }
    function isMember(hid) { return hasAccess() && me() in space(hid).members; }
    function canView(hid) { let d = space(hid); return hasAccess() && (me() in d.members || me() in d.get('viewers', [])); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function onlyMyKey(field) { return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([me()]); }

    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if hasAccess() && me() == uid;
    }

    // who's allowed in (written only by the server)
    match /access/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow write: if false;
    }

    // invite codes, made by an admin; used up on the server
    match /invites/{code} {
      allow create: if isAdmin() && request.resource.data.by == me() && request.resource.data.get('used', []).size() == 0
                    && request.resource.data.expires is int && request.resource.data.max is int && request.resource.data.max <= 20;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /households/{hid} {
      allow create: if hasAccess() && request.resource.data.members == [me()]
                    && request.resource.data.get('owner', me()) == me()
                    && request.resource.data.get('viewers', []).size() == 0;
      allow read: if hasAccess() && (me() in resource.data.members || me() in resource.data.get('viewers', []));
      allow update: if hasAccess() && (
        // the owner (or any member of an old-style household that has no owner yet)
        (me() in resource.data.members && resource.data.get('owner', me()) == me())
        // a member changing only their own name / colour in a group
        || (me() in resource.data.members && onlyKeys(['names', 'colors']) && onlyMyKey('names') && onlyMyKey('colors'))
        // a member leaving a group (the owner can't leave)
        || (me() in resource.data.members && onlyKeys(['members'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([me()].toSet()))
        // someone joining a group with an invite link, while invitations are open
        || (resource.data.get('type', 'group') == 'group'
            && resource.data.get('joinUntil', 0) > request.time.toMillis()
            && onlyKeys(['members', 'names', 'personOf'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().union([me()].toSet())
            && onlyMyKey('names') && onlyMyKey('personOf')
            && resource.data.members.size() < 20)
      );
      allow delete: if false;

      match /{sub}/{docId} {
        allow read: if canView(hid);
        allow create: if isMember(hid) && request.resource.data.get('author', '') == me();
        allow update: if isMember(hid) && resource.data.get('author', me()) == me() && request.resource.data.get('author', '') == me();
        allow delete: if isMember(hid) && resource.data.get('author', me()) == me();
      }
    }

    // "Can I see your dashboard?" requests between people who share a group.
    match /viewRequests/{rid} {
      allow create: if hasAccess() && request.resource.data.from == me() && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'status', 'created', 'group']);
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow update: if signedIn() && resource.data.to == me() && onlyKeys(['status', 'space', 'toName', 'answered']);
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // Money sent straight to another person (no shared group needed). The receiver's app adds it
    // to their own space; the server sends the push. Nobody can change a transfer once it's sent.
    match /transfers/{tid} {
      allow create: if hasAccess() && request.resource.data.from == me() && request.resource.data.author == me()
                    && request.resource.data.to is string && request.resource.data.to != me()
                    && request.resource.data.amount is number && request.resource.data.amount > 0
                    && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'amount', 'date', 'note', 'created', 'author']);
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow delete: if signedIn() && resource.data.from == me();
      allow update: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
