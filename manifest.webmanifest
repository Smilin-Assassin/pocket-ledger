{
  "name": "Pocket Ledger",
  "short_name": "Pocket Ledger",
  "description": "Household money tracker: income, spending, savings goals and receipt scanning.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#2B1B3D",
  "theme_color": "#FBF7F3",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            "text/csv",
            ".csv",
            "text/comma-separated-values"
          ]
        }
      ]
    }
  },
  "id": "./",
  "shortcuts": [
    {
      "name": "Scan a receipt",
      "short_name": "Scan",
      "url": "./?action=scan",
      "icons": [
        {
          "src": "icons/sc-scan.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Talk to Pocket Ledger",
      "short_name": "Talk",
      "url": "./?action=voice",
      "icons": [
        {
          "src": "icons/sc-mic.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add an expense",
      "short_name": "Add",
      "url": "./?action=add",
      "icons": [
        {
          "src": "icons/sc-add.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ask about your money",
      "short_name": "Ask",
      "url": "./?action=chat",
      "icons": [
        {
          "src": "icons/sc-chat.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}